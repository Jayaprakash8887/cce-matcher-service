            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
              "valueInteger": 1
            }
          ],
          "description": "Awaiting OpenMRS acknowledgement for ANC Visit 1 referral. Created when referral completes.",
