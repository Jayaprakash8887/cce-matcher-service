{
  "resourceType": "PlanDefinition",
  "id": "anc-high-risk",
  "url": "http://openphc.org/PlanDefinition/anc-high-risk",
  "version": "1.0.0",
  "name": "ANCHighRiskProtocol",
  "title": "Antenatal Care \u2014 High-Risk Protocol",
  "status": "active",
  "date": "2026-01-15",
  "description": "Protocol for monitoring high-risk antenatal patients. Includes initial enrollment, blood pressure checks, lab work, and follow-up visits.",
  "action": [
    {
      "id": "initial-enrollment",
      "title": "Initial Enrollment on ANC Encounter",
      "description": "Enroll patient when a high-risk ANC encounter is completed.",
      "trigger": [
        {
          "type": "named-event",
          "name": "enrollment-trigger",
          "data": [
            {
              "type": "Encounter",
              "codeFilter": [
                {
                  "path": "type",
                  "code": [
                    {
                      "system": "http://openphc.org/encounter-types",
                      "code": "anc-visit"
                    }
                  ]
                },
                {
                  "path": "serviceType",
                  "code": [
                    {
                      "system": "http://openphc.org/service-types",
                      "code": "high-risk-anc"
                    }
                  ]
                }
              ]
            }
          ],
          "condition": {
            "language": "text/jsonlogic",
            "expression": "{\"==\": [{\"var\": \"status\"}, \"finished\"]}"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "blood-pressure-check",
      "title": "Blood Pressure Check",
      "description": "Scheduled blood pressure observation for monitoring hypertension risk.",
      "trigger": [
        {
          "type": "named-event",
          "name": "bp-observation-trigger",
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "path": "code",
                  "code": [
                    {
                      "system": "http://loinc.org",
                      "code": "85354-9"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "relatedAction": [
        {
          "actionId": "initial-enrollment",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 7,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 4,
          "frequency": 1,
          "period": 7,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 3
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "lab-work",
      "title": "Laboratory Work",
      "description": "Comprehensive lab panel required for high-risk patients.",
      "trigger": [
        {
          "type": "named-event",
          "name": "lab-trigger",
          "data": [
            {
              "type": "DiagnosticReport",
              "codeFilter": [
                {
                  "path": "code",
                  "code": [
                    {
                      "system": "http://loinc.org",
                      "code": "24323-8"
                    }
                  ]
                },
                {
                  "path": "category",
                  "code": [
                    {
                      "system": "http://terminology.hl7.org/CodeSystem/v2-0074",
                      "code": "LAB"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "relatedAction": [
        {
          "actionId": "blood-pressure-check",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 14,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "any-encounter-log",
      "title": "Log Any Encounter",
      "description": "Track all encounters of type Encounter \u2014 broadest match (Scenario 1: F1 only).",
      "trigger": [
        {
          "type": "named-event",
          "name": "any-encounter-trigger",
          "data": [
            {
              "type": "Encounter"
            }
          ]
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "encounter-condition-only",
      "title": "Encounter with Condition Filter",
      "description": "Match Encounter by resource type + condition, no codeFilter (Scenario 3: F1,F3).",
      "trigger": [
        {
          "type": "named-event",
          "name": "encounter-condition-trigger",
          "data": [
            {
              "type": "Encounter"
            }
          ],
          "condition": {
            "language": "text/fhirpath",
            "expression": "Encounter.status = 'finished'"
          }
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "global-risk-assessment",
      "title": "Global Risk Assessment",
      "description": "Condition-only trigger \u2014 evaluated for every inbound event (Scenario 5: F3 only).",
      "trigger": [
        {
          "type": "named-event",
          "name": "risk-assessment-trigger",
          "condition": {
            "language": "text/jsonlogic",
            "expression": "{\">\": [{\"var\": \"riskScore\"}, 7]}"
          }
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    }
  ]
}
