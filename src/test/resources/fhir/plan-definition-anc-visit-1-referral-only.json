{
  "id": "anc-visit-1-referral-protocol",
  "url": "http://mdtlabs.com/PlanDefinition/anc-visit-1-referral-protocol",
  "date": "2026-05-25",
  "name": "ANCVisit1ReferralProtocol",
  "title": "ANC Visit 1 Referral Protocol",
  "action": [
    {
      "id": "anc1-referral-initiated",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "ANC Visit 1 Referral Initiated",
      "action": [
        {
          "id": "anc1-referral-initiated-escalation",
          "type": {
            "coding": [
              {
                "code": "fire-event",
                "system": "http://terminology.hl7.org/CodeSystem/action-type"
              }
            ]
          },
          "title": "Urgent ANC Visit 1 Referral Escalation",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/jsonlogic",
                "expression": "{\"==\": [{\"var\": \"event.stepStatus\"}, \"completed\"]}"
              }
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
              "valueCode": "CRITICAL"
            },
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
              "valueCode": "OPENMRS"
            }
          ],
          "definitionCanonical": "http://openphc.org/ActivityDefinition/anc-urgent-escalation|1.0.0"
        }
      ],
      "trigger": [
        {
          "data": [
            {
              "type": "ServiceRequest",
              "codeFilter": [
                {
                  "code": [
                    {
                      "code": "Pregnant, Referred",
                      "system": "http://mdtlabs.com/patient-status"
                    }
                  ],
                  "path": "identifier"
                }
              ]
            }
          ],
          "name": "anc1-referral-initiated-trigger",
          "type": "named-event",
          "condition": {
            "language": "text/fhirpath",
            "expression": "ServiceRequest.patientInstruction.matches('.*ANC Visit +1') and ServiceRequest.status = 'active' and ServiceRequest.meta.versionId = '1'"
          }
        }
      ],
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 7
        }
      ],
      "description": "ANC Visit 1 referral initiated. Entry-point step for the referral chain.",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 28,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "requiredBehavior": "must"
    },
    {
      "id": "anc1-referral-consultation",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "ANC Visit 1 Referral Consultation",
      "action": [
        {
          "id": "anc1-referral-consultation-overdue-notification",
          "type": {
            "coding": [
              {
                "code": "fire-event",
                "system": "http://terminology.hl7.org/CodeSystem/action-type"
              }
            ]
          },
          "title": "Referral Consultation Overdue Notification",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/jsonlogic",
                "expression": "{\"==\": [{\"var\": \"event.deviationType\"}, \"OVERDUE\"]}"
              }
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
              "valueCode": "HIGH"
            },
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
              "valueCode": "OPENMRS"
            }
          ],
          "definitionCanonical": "http://openphc.org/ActivityDefinition/anc-urgent-escalation|1.0.0"
        }
      ],
      "trigger": [
        {
          "data": [
            {
              "type": "Encounter",
              "codeFilter": [
                {
                  "code": [
                    {
                      "code": "479e4805-90d9-44f5-b252-333d8a687e52",
                      "system": "http://fhir.openmrs.org/code-system/encounter-type",
                      "display": "Referral Response"
                    }
                  ],
                  "path": "type"
                }
              ]
            }
          ],
          "name": "anc1-referral-consultation-trigger",
          "type": "named-event",
          "condition": {
            "language": "text/fhirpath",
            "expression": "Encounter.extension.where(url='http://cce.openphc.org/StructureDefinition/source-referral-order').extension.where(url='instructions').value.text.matches('.*ANC Visit +1')"
          }
        }
      ],
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 3
        }
      ],
      "description": "Referral consultation at referred facility for ANC Visit 1.",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 7,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "relatedAction": [
        {
          "actionId": "anc1-referral-initiated",
          "relationship": "after-end",
          "offsetDuration": {
            "code": "d",
            "unit": "d",
            "value": 30,
            "system": "http://unitsofmeasure.org"
          }
        }
      ],
      "requiredBehavior": "must"
    },
    {
      "id": "anc1-referral-closure",
      "type": {
        "coding": [
          {
            "code": "step",
            "system": "http://openphc.org/fhir/CodeSystem/action-type"
          }
        ]
      },
      "title": "ANC Visit 1 Referral Closure",
      "action": [
        {
          "id": "anc1-referral-closure-overdue-notification",
          "type": {
            "coding": [
              {
                "code": "fire-event",
                "system": "http://terminology.hl7.org/CodeSystem/action-type"
              }
            ]
          },
          "title": "Overdue Response Notification",
          "condition": [
            {
              "kind": "applicability",
              "expression": {
                "language": "text/jsonlogic",
                "expression": "{\"==\": [{\"var\": \"event.deviationType\"}, \"OVERDUE\"]}"
              }
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
              "valueCode": "HIGH"
            },
            {
              "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
              "valueCode": "OPENMRS"
            }
          ],
          "definitionCanonical": "http://openphc.org/ActivityDefinition/anc-urgent-escalation|1.0.0"
        }
      ],
      "trigger": [
        {
          "data": [
            {
              "type": "ServiceRequest",
              "codeFilter": [
                {
                  "code": [
                    {
                      "code": "referral-response",
                      "system": "http://cce.openphc.org/CodeSystem/event-type"
                    }
                  ],
                  "path": "category"
                }
              ]
            }
          ],
          "name": "anc1-referral-closure-trigger",
          "type": "named-event",
          "condition": {
            "language": "text/fhirpath",
            "expression": "ServiceRequest.orderDetail.text.matches('.*ANC Visit +1')"
          }
        }
      ],
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "description": "Awaiting OpenMRS acknowledgement for ANC Visit 1 referral.",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 1,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "relatedAction": [
        {
          "actionId": "anc1-referral-consultation",
          "relationship": "after-end"
        }
      ],
      "requiredBehavior": "must"
    }
  ],
  "status": "active",
  "version": "1.0.0",
  "description": "Standalone referral chain protocol for ANC Visit 1 — tracks initiated, consultation and closure steps independently from the full RMNCH protocol.",
  "resourceType": "PlanDefinition"
}
