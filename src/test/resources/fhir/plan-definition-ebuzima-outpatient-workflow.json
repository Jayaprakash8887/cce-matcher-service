{
  "resourceType": "PlanDefinition",
  "id": "ebuzima-outpatient-workflow",
  "url": "http://openphc.org/PlanDefinition/ebuzima-outpatient-workflow",
  "version": "1.0.0",
  "name": "EbuzimaOutpatientWorkflow",
  "title": "Ebuzima Outpatient Diabetes Screening & Management Workflow",
  "status": "active",
  "date": "2026-04-22",
  "description": "Tracks an outpatient visit workflow from the Ebuzima HIE: patient check-in, vitals recording, clinical consultation (chief complaints, history), laboratory ordering and results, diagnosis, and treatment prescription. Designed to match CloudEvents from the OpenHIM mediator carrying FHIR R4 resources.",
  "action": [
    {
      "id": "visit-encounter",
      "title": "Patient Visit Encounter",
      "description": "Enrollment trigger \u2014 patient check-in at nursing station. Matches any Encounter (F1 scenario: resource type only). Encounter type coding in Ebuzima payloads uses display-only values (no code field), so codeFilter cannot be applied.",
      "trigger": [
        {
          "type": "named-event",
          "name": "visit-encounter-trigger",
          "data": [
            {
              "type": "Encounter"
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "vitals-recording",
      "title": "Vitals Recording",
      "description": "Nursing station vitals observation. Matches Observation with LOINC code 8716-3 (Vital signs). Payload includes BP, HR, RR, SpO2, temp, weight, height, BMI, blood glucose as components.",
      "trigger": [
        {
          "type": "named-event",
          "name": "vitals-trigger",
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "path": "code",
                  "code": [
                    {
                      "system": "http://loinc.org",
                      "code": "8716-3",
                      "display": "Vital signs"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "visit-encounter",
          "relationship": "after-start",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "chief-complaints",
      "title": "Chief Complaints",
      "description": "Clinical consultation \u2014 chief complaints recording. Matches Observation with LOINC code 33747-0 (Chief Complaints).",
      "trigger": [
        {
          "type": "named-event",
          "name": "chief-complaints-trigger",
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "path": "code",
                  "code": [
                    {
                      "system": "http://loinc.org",
                      "code": "33747-0",
                      "display": "Chief Complaints"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "vitals-recording",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "history-assessment",
      "title": "History of Present Illness",
      "description": "Clinical consultation \u2014 history recording. Matches Observation with LOINC code 10164-2 (History of Present illness Narrative).",
      "trigger": [
        {
          "type": "named-event",
          "name": "history-trigger",
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "path": "code",
                  "code": [
                    {
                      "system": "http://loinc.org",
                      "code": "10164-2",
                      "display": "History of Present illness Narrative"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "requiredBehavior": "could",
      "relatedAction": [
        {
          "actionId": "chief-complaints",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "lab-order",
      "title": "Laboratory Order",
      "description": "Lab test ordered by clinician. Matches any ServiceRequest (F1 scenario). Ebuzima ServiceRequest payloads have non-standard category structure (object instead of array), so only resource-type matching is used.",
      "trigger": [
        {
          "type": "named-event",
          "name": "lab-order-trigger",
          "data": [
            {
              "type": "ServiceRequest"
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "history-assessment",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "lab-results",
      "title": "Laboratory Results",
      "description": "Lab results returned. Matches Observation with category 'laboratory'. Uses category-path codeFilter to distinguish from vital-signs and survey observations.",
      "trigger": [
        {
          "type": "named-event",
          "name": "lab-results-trigger",
          "data": [
            {
              "type": "Observation",
              "codeFilter": [
                {
                  "path": "category",
                  "code": [
                    {
                      "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                      "code": "laboratory",
                      "display": "Laboratory"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "lab-order",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 3,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 5
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "diagnosis",
      "title": "Clinical Diagnosis",
      "description": "Diagnosis recorded. Matches Condition with clinicalStatus 'active'. The Ebuzima payload carries ICD code 5A11 (Type 2 diabetes mellitus) in the code field.",
      "trigger": [
        {
          "type": "named-event",
          "name": "diagnosis-trigger",
          "data": [
            {
              "type": "Condition",
              "codeFilter": [
                {
                  "path": "clinicalStatus",
                  "code": [
                    {
                      "system": "http://terminology.hl7.org/CodeSystem/condition-clinical",
                      "code": "active"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "lab-results",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 1,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    },
    {
      "id": "treatment",
      "title": "Treatment Prescription",
      "description": "Medication prescribed. Matches any MedicationRequest (F1 scenario). Ebuzima payloads use medicationCodeableConcept which is not in the standard extraction paths, so only resource-type matching is used. Expected medications: CAPTOPRIL 25MG (C09AA0101E), METFORMIN 500MG (A10BA0201E).",
      "trigger": [
        {
          "type": "named-event",
          "name": "treatment-trigger",
          "data": [
            {
              "type": "MedicationRequest"
            }
          ]
        }
      ],
      "requiredBehavior": "must",
      "relatedAction": [
        {
          "actionId": "diagnosis",
          "relationship": "after-end",
          "offsetDuration": {
            "value": 0,
            "unit": "d",
            "system": "http://unitsofmeasure.org",
            "code": "d"
          }
        }
      ],
      "timingTiming": {
        "repeat": {
          "count": 1,
          "frequency": 1,
          "period": 1,
          "periodUnit": "d"
        }
      },
      "extension": [
        {
          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
          "valueInteger": 1
        }
      ],
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      }
    }
  ]
}
