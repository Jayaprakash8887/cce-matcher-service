            "coding": [
              {
                "code": "step",
                "system": "http://openphc.org/fhir/CodeSystem/action-type"
              }
            ]
          },
          "title": "ANC Visit 1 Referral Initiated",
          "action": [
            {
              "id": "anc-visit-1-referral-escalation",
              "type": {
                "coding": [
                  {
                    "code": "fire-event",
                    "system": "http://terminology.hl7.org/CodeSystem/action-type"
                  }
                ]
              },
              "title": "Urgent ANC Visit 1 Referral Escalation",
              "condition": [
                {
                  "kind": "applicability",
                  "expression": {
                    "language": "text/jsonlogic",
                    "expression": "{\"==\": [{\"var\": \"event.stepStatus\"}, \"completed\"]}"
                  }
                }
              ],
              "extension": [
                {
                  "url": "http://openphc.org/fhir/StructureDefinition/intelligence-severity",
                  "valueCode": "CRITICAL"
                },
                {
                  "url": "http://openphc.org/fhir/StructureDefinition/intelligence-destination",
                  "valueCode": "OPENMRS"
                }
              ],
              "definitionCanonical": "http://openphc.org/ActivityDefinition/anc-urgent-escalation|1.0.0"
            }
          ],
          "trigger": [
            {
              "data": [
                {
                  "type": "ServiceRequest",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "code": "Pregnant, Referred",
                          "system": "http://mdtlabs.com/patient-status"
                        }
                      ],
                      "path": "identifier"
                    }
                  ]
                }
              ],
              "name": "anc-visit-1-referral-trigger",
              "type": "named-event",
              "condition": {
                "language": "text/fhirpath",
                "expression": "ServiceRequest.patientInstruction.matches(''.*ANC Visit +1'') and ServiceRequest.status = ''active'' and ServiceRequest.meta.versionId = ''1''"
              }
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
              "valueInteger": 7
            }
          ],
          "description": "ANC Visit 1 referral. Entry-point sub-step \u2014 created when ANC Visit 1 completes.",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 28,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "requiredBehavior": "must"
        },
        {
